        <mxCell id="Paiks7txRWPpxiB2cn6C-9" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;labelBackgroundColor=light-dark(#FFFFFF,#FFFFFF);fontColor=light-dark(#000000,#000000);fontStyle=5;fontSize=14;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;p dir=&quot;auto&quot; style=&quot;white-space-collapse: preserve;&quot;&gt;High Availability 3-Tier Web Application – Multi-AZ LAMP Guestbook Demo&lt;/p&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="120" width="1140" x="108" y="-627" as="geometry" />
        </mxCell>
        <mxCell id="Paiks7txRWPpxiB2cn6C-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;font style=&quot;&quot;&gt;&lt;u style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&lt;b&gt;Key Labels / Arrows&lt;/b&gt;:&lt;/span&gt;&lt;br style=&quot;white-space-collapse: preserve;&quot;&gt;&lt;/font&gt;&lt;/u&gt;&lt;span style=&quot;font-size: 14px; white-space-collapse: preserve;&quot;&gt;- &lt;u&gt;&lt;b&gt;Solid arrows&lt;/b&gt;&lt;/u&gt;: Traffic flow (Internet → Route 53 → ALB → EC2 → RDS)&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br style=&quot;white-space-collapse: preserve;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; white-space-collapse: preserve;&quot;&gt;- &lt;u&gt;&lt;b&gt;Dashed arrows&lt;/b&gt;&lt;/u&gt;: Monitoring / Health checks (CloudWatch → ASG,/ALB health checks → EC2)&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br style=&quot;white-space-collapse: preserve;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; white-space-collapse: preserve;&quot;&gt;- &lt;u&gt;&lt;b&gt;Group boxes&lt;/b&gt;&lt;/u&gt;: VPC boundary (large rectangle around everything)&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br style=&quot;white-space-collapse: preserve;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; white-space-collapse: preserve;&quot;&gt;- &lt;u&gt;&lt;b&gt;AZ labels&lt;/b&gt;&lt;/u&gt;: us-east-1a | us-east-1b (vertical columns)&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br style=&quot;white-space-collapse: preserve;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; white-space-collapse: preserve;&quot;&gt;- &lt;u&gt;&lt;b&gt;Security&lt;/b&gt;&lt;/u&gt;: Note &quot;Security Groups: ALB allows 80/443 from 0.0.0.0/0; EC2 allows 80/443 from ALB only; RDS allows 5432 from EC2&quot;&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br style=&quot;white-space-collapse: preserve;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- &lt;u&gt;&lt;b&gt;Cost/HA notes&lt;/b&gt;&lt;/u&gt;: &quot;Multi-AZ RDS &amp;amp; ASG for High Availability, Spot in ASG for cost optimization.&quot;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;-&lt;u&gt;&lt;b&gt;&#39;Ghost&#39; Port 22&lt;/b&gt;&lt;/u&gt;: &lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Zero SSH (Port 22) Access. Administration via AWS Systems Manager (SSM) over HTTPS (443).&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="620" x="260" y="640" as="geometry" />
        </mxCell>
